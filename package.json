{
  "name": "sealpad",
  "private": true,
  "version": "0.1.0",
  "description": "印台 SealPad：离线、开源的 PDF 盖章与签名工具",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @sealpad/web dev",
    "build": "pnpm --filter @sealpad/web build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "pnpm --filter @sealpad/web e2e",
    "desktop:dev": "pnpm --filter @sealpad/desktop tauri dev",
    "desktop:build": "pnpm --filter @sealpad/desktop tauri build"
  }
}
