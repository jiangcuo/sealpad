{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SealPad",
  "mainBinaryName": "sealpad",
  "version": "0.1.0",
  "identifier": "io.github.jiangcuo.sealpad",
  "build": {
    "beforeDevCommand": "pnpm --filter @sealpad/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @sealpad/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "印台 SealPad",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SealPad contributors",
    "homepage": "https://github.com/jiangcuo/sealpad",
    "category": "Productivity",
    "shortDescription": "离线、开源的 PDF 盖章与签名工具",
    "longDescription": "印台 SealPad：导入印章和签名，在 PDF 上按真实尺寸盖章、加骑缝章并导出。所有文件只在本机处理。",
    "copyright": "Copyright © SealPad contributors. Apache-2.0.",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "section": "office"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
